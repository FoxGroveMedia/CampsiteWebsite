{% macro docsAnchors(page, title="On this page", links=[]) %}
{% set normalizedCurrent = page.path or '' %}
{% if normalizedCurrent and normalizedCurrent.endsWith('/') %}
{% set normalizedCurrent = normalizedCurrent.slice(0, -1) %}
{% endif %}
{% if not links or links | length == 0 %}
{% set links = [] %}
{% endif %}
{% set baseLinkClasses = "block w-full" %}
{% set activeClasses = "font-semibold text-amber-500" %}
{% set inactiveClasses = "text-stone-500 hover:text-white dark:text-stone-400 dark:hover:text-stone-300" %}

<aside class="col-span-2 col-start-10 w-80 relative hidden xl:block px-4 lg:px-0">
  <div class="sticky top-[100px] max-h-[calc(100vh-120px)] overflow-y-auto pt-8 pb-10 lg:pr-8">
    <div class="relative overflow-hidden bg-stone-950/50 dark:bg-stone-900/50 border-l-4 border-t border-r border-b  border-stone-800 rounded-lg py-6 pr-6">
      <svg class="absolute z-0 top-0 -right-20 size-56 fill-stone-900" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Pro v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2025 Fonticons, Inc.--><path d="M144 252.6C144 157.5 222.5 80 320 80C417.5 80 496 157.5 496 252.6C496 307.6 468 369.9 432.1 426.8C396.5 483.1 354.6 531.7 329.9 558.6C324.4 564.6 315.6 564.6 310.2 558.6C285.4 531.7 243.5 483.1 207.9 426.8C172 370 144 307.6 144 252.6zM320 64C214 64 128 148.4 128 252.6C128 371.9 248.2 514.9 298.4 569.4C310.2 582.2 329.8 582.2 341.6 569.4C391.8 514.9 512 371.9 512 252.6C512 148.4 426 64 320 64zM320 336C364.2 336 400 300.2 400 256C400 211.8 364.2 176 320 176C275.8 176 240 211.8 240 256C240 300.2 275.8 336 320 336zM256 256C256 220.7 284.7 192 320 192C355.3 192 384 220.7 384 256C384 291.3 355.3 320 320 320C284.7 320 256 291.3 256 256z"/></svg>
      <h2 class="text-xl text-white pl-2 flex items-center gap-2">
        <svg class="size-6" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Pro v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2025 Fonticons, Inc.--><path d="M176 252.6C176 175.7 239.7 112 320 112C400.3 112 464 175.7 464 252.6C464 298.2 440.2 354.1 405.1 409.7C376.8 454.5 344.1 494.5 320 521.8C295.9 494.5 263.3 454.6 234.9 409.7C199.8 354.2 176 298.2 176 252.6zM320 64C214 64 128 148.4 128 252.6C128 371.9 248.2 514.9 298.4 569.4C310.2 582.2 329.8 582.2 341.6 569.4C391.8 514.9 512 371.9 512 252.6C512 148.4 426 64 320 64zM288 256C288 238.3 302.3 224 320 224C337.7 224 352 238.3 352 256C352 273.7 337.7 288 320 288C302.3 288 288 273.7 288 256zM400 256C400 211.8 364.2 176 320 176C275.8 176 240 211.8 240 256C240 300.2 275.8 336 320 336C364.2 336 400 300.2 400 256z"/></svg>
        <span>{{ title }}</span></h2>
      <ul data-docs-anchor role="list"
        class="space-y-2 lg:space-y-3 border-l-4 border-stone-800 dark:border-stone-800 pt-4 -ml-1">
        {% for link in links %}
        {% set normalizedHref = link.href %}
        {% if normalizedHref and normalizedHref.endsWith('/') %}
        {% set normalizedHref = normalizedHref.slice(0, -1) %}
        {% endif %}
        {% set isActive = normalizedCurrent == normalizedHref %}
        <li class="group relative">
          <a class="{{ baseLinkClasses }} {% if isActive %}{{ activeClasses }}{% else %}{{ inactiveClasses }}{% endif %} flex items-center gap-2 pl-4"
            href="{{ link.href }}" id="{{ link.href | replace('#', '') }}">
            <!-- <svg class="absolute size-6 left-0 -translate-x-3.5 bg-stone-950" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                {% if isActive %}
                <path d="M528 320C528 205.1 434.9 112 320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM370.7 389.1L226.4 444.6C207 452.1 187.9 433 195.4 413.6L250.9 269.3C254.2 260.8 260.8 254.2 269.3 250.9L413.6 195.4C433 187.9 452.1 207 444.6 226.4L389.1 370.7C385.8 379.2 379.2 385.8 370.7 389.1zM352 320C352 302.3 337.7 288 320 288C302.3 288 288 302.3 288 320C288 337.7 302.3 352 320 352C337.7 352 352 337.7 352 320z"/>
                {% else %}
                <path d="M528 320C528 205.1 434.9 112 320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320z"/>
                {% endif %}
              </svg> -->
            <!-- <svg class="absolute size-6 left-0 -translate-x-3.5 bg-[#170900]" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.<path d="M439.1 297.4C451.6 309.9 451.6 330.2 439.1 342.7L279.1 502.7C266.6 515.2 246.3 515.2 233.8 502.7C221.3 490.2 221.3 469.9 233.8 457.4L371.2 320L233.9 182.6C221.4 170.1 221.4 149.8 233.9 137.3C246.4 124.8 266.7 124.8 279.2 137.3L439.2 297.3z"/></svg> -->
            {% set normalizedLabel = link.label | labelize %}
            <span class="pt-0.5 capitalize">{{ normalizedLabel }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</aside>
{% endmacro %}