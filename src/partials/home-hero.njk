<section class="max-w-7xl mx-auto px-6 pt-24 pb-16 text-center">

  <span class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 text-xs font-medium text-zinc-300 mb-8">
    <span class="w-2 h-2 bg-[#EA4B71] rounded-full animate-pulse" aria-hidden="true"></span>
    Now with Tailwind CSS v4 support
  </span>

  <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white mb-6 max-w-4xl mx-auto leading-tight">
    Pack light, <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EA4B71] to-[#FF6C37]">Pitch fast</span>,<br>and build with ease.
  </h1>

  <p class="text-xl text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed">
    {{ site.description }}
  </p>

  <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
    <a href="/docs/getting-started/installation"
      class="w-full sm:w-auto bg-gradient-to-r from-[#EA4B71] to-[#FF6C37] text-white px-8 py-3.5 rounded-xl font-semibold hover:shadow-[0_0_24px_rgba(234,75,113,0.35)] transition-shadow">
      Get Started Free
    </a>
    <a href="/docs"
      class="w-full sm:w-auto bg-white/5 hover:bg-white/10 border border-white/10 text-white px-8 py-3.5 rounded-xl font-semibold transition-colors">
      Read the Docs
    </a>
  </div>

  <div class="mt-20 relative glow-box rounded-2xl bg-[#0E0B16] border border-white/5 max-w-5xl mx-auto overflow-hidden shadow-2xl">
    <div class="flex items-center justify-between border-b border-white/5 px-4 py-3">
      <div class="flex items-center gap-2" aria-hidden="true">
        <span class="w-3 h-3 bg-red-500/70 rounded-full"></span>
        <span class="w-3 h-3 bg-yellow-500/70 rounded-full"></span>
        <span class="w-3 h-3 bg-green-500/70 rounded-full"></span>
      </div>
      <div class="text-xs text-zinc-400 font-mono">campsite build</div>
      <div class="w-10" aria-hidden="true"></div>
    </div>

    <div class="h-[360px] relative flex items-center justify-center px-6">
      <div class="relative flex flex-col md:flex-row gap-8 items-center">

        <div class="bg-[#1C162E] border border-white/10 p-4 rounded-xl w-48 shadow-lg text-left">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-6 h-6 bg-[#EA4B71] rounded flex items-center justify-center text-xs font-bold text-white">{ }</span>
            <span class="font-semibold text-sm">Source Files</span>
          </div>
          <div class="space-y-1">
            <p class="text-xs text-zinc-400 font-mono">.njk templates</p>
            <p class="text-xs text-zinc-400 font-mono">.md content</p>
            <p class="text-xs text-zinc-400 font-mono">.liquid pages</p>
          </div>
        </div>

        <div class="w-12 h-0.5 bg-gradient-to-r from-[#EA4B71] to-[#FF6C37] relative hidden md:block" aria-hidden="true">
          <div class="absolute w-2 h-2 bg-white rounded-full -top-[3px] left-1/2 transform -translate-x-1/2 animate-ping"></div>
        </div>
        <div class="w-0.5 h-12 bg-gradient-to-b from-[#EA4B71] to-[#FF6C37] md:hidden" aria-hidden="true"></div>

        <div class="bg-[#1C162E] border border-[#EA4B71]/40 p-4 rounded-xl w-48 shadow-lg text-left glow-box">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-6 h-6 bg-[#05030A] rounded flex items-center justify-center">
              <svg class="w-4 h-4" viewBox="75 -2 115 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M134.546 2.66474C135.937 0.279749 138.999 -0.526184 141.384 0.86493C143.769 2.25633 144.575 5.31854 143.184 7.7038L94.6944 90.8288C93.303 93.214 90.2408 94.02 87.8556 92.6286C85.4703 91.2372 84.6644 88.175 86.0557 85.7897L134.546 2.66474Z" fill="white"/>
                <path d="M117.873 0.86493C120.258 -0.526422 123.32 0.279495 124.712 2.66473L173.201 85.7897C174.592 88.175 173.786 91.2372 171.401 92.6286C169.016 94.0197 165.955 93.2138 164.563 90.8288L116.073 7.7038C114.682 5.31855 115.488 2.25632 117.873 0.86493Z" fill="white"/>
                <path d="M175.809 83.3093C178.571 83.3094 180.809 85.5479 180.809 88.3093C180.809 91.0706 178.571 93.3091 175.809 93.3093H83.448C80.6866 93.3093 78.448 91.0707 78.448 88.3093C78.448 85.5478 80.6866 83.3093 83.448 83.3093H175.809Z" fill="white"/>
                <path d="M129.628 53.601C131.407 53.601 133.052 54.5453 133.948 56.0814L142.111 70.7904C143.502 73.1756 142.696 76.237 140.311 77.6283C137.926 79.0196 134.865 78.2137 133.473 75.8285L129.628 68.5238L125.785 75.8285C124.393 78.2138 121.331 79.0197 118.946 77.6283C116.561 76.237 115.755 73.1756 117.146 70.7904L125.31 56.0814L125.486 55.8002C126.411 54.4308 127.961 53.601 129.628 53.601Z" fill="#FF6C37"/>
              </svg>
            </span>
            <span class="font-semibold text-sm">CampsiteJS</span>
          </div>
          <div class="space-y-1">
            <p class="text-xs text-zinc-500">Renders templates</p>
            <p class="text-xs text-zinc-500">Compiles Tailwind</p>
            <p class="text-xs text-zinc-500">Optimizes assets</p>
          </div>
        </div>

        <div class="w-12 h-0.5 bg-gradient-to-r from-[#FF6C37] to-purple-500 relative hidden md:block" aria-hidden="true">
          <div class="absolute w-2 h-2 bg-white rounded-full -top-[3px] left-1/2 transform -translate-x-1/2 animate-ping" style="animation-delay: 0.5s"></div>
        </div>
        <div class="w-0.5 h-12 bg-gradient-to-b from-[#FF6C37] to-purple-500 md:hidden" aria-hidden="true"></div>

        <div class="bg-[#1C162E] border border-white/10 p-4 rounded-xl w-48 shadow-lg text-left">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-6 h-6 bg-purple-500 rounded flex items-center justify-center text-xs font-bold">✓</span>
            <span class="font-semibold text-sm">Static Output</span>
          </div>
          <div class="space-y-1">
            <p class="text-xs text-zinc-500 font-mono">HTML / CSS / JS</p>
            <p class="text-xs text-zinc-500 font-mono">Ready to deploy</p>
            <p class="text-xs text-zinc-500 font-mono">public/ folder</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
