{% macro docsSidebar(current, title="Getting Started", links=[]) %}
  {% set normalizedCurrent = current or '' %}
  {% if normalizedCurrent and normalizedCurrent.endsWith('/') %}
    {% set normalizedCurrent = normalizedCurrent.slice(0, -1) %}
  {% endif %}
  {% if not links or links | length == 0 %}
    {% set links = [] %}
  {% endif %}
  <div>
    <h2 class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-3">{{ title }}</h2>
    <ul role="list" class="space-y-1 border-l border-white/10 pl-3 mb-8">
      {% for link in links %}
        {% set normalizedHref = link.href %}
        {% if normalizedHref and normalizedHref.endsWith('/') %}
          {% set normalizedHref = normalizedHref.slice(0, -1) %}
        {% endif %}
        {% set isActive = normalizedCurrent == normalizedHref %}
        <li>
          <a class="block text-sm py-1 px-2 rounded-md transition-colors
            {% if isActive %}
              text-[#EA4B71] font-semibold bg-[#EA4B71]/5
            {% else %}
              text-zinc-500 hover:text-white hover:bg-white/5
            {% endif %}"
            href="{{ link.href }}">
            {{ link.label }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endmacro %}
