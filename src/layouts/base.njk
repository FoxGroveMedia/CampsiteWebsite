  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.Prism) return;

      // Normalize Nunjucks / NJK blocks to get HTML-like syntax highlighting
      document.querySelectorAll('code[class*="language-njk"], code[class*="language-nunjucks"]').forEach(function (el) {
        el.classList.remove('language-njk', 'language-nunjucks');
        el.classList.add('language-markup');
      });

      // Give any code block without a language class a fallback so it still gets colored
      document.querySelectorAll('pre > code:not([class*="language-"])').forEach(function (block) {
        block.classList.add('language-plaintext');
      });

      // Highlight everything
      Prism.highlightAll();
    });
