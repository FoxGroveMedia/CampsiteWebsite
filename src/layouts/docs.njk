{% extends "base.njk" %}
{% from "partials/docs-sidebar.njk" import docsSidebar %}
{% from "partials/docs-anchors.njk" import docsAnchors %}

{% block content %}
<el-dialog>
  <dialog id="sidebar" class="m-0 p-0 backdrop:bg-transparent lg:hidden">
    <el-dialog-backdrop
      class="fixed inset-0 bg-stone-950/90 transition-opacity duration-300 ease-linear data-[closed]:opacity-0"></el-dialog-backdrop>

    <div tabindex="0" class="fixed inset-0 flex focus:outline focus:outline-0">
      <el-dialog-panel
        class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-[closed]:-translate-x-full">
        <div
          class="absolute left-full top-0 flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-[closed]/dialog-panel:opacity-0">
          <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
            <span class="sr-only">Close sidebar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon"
              aria-hidden="true" class="size-6 text-white">
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <!-- Sidebar component, swap this element with another sidebar if you like -->
        <div
          class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-stone-950/80 py-8 px-6 ring-1 ring-white/10 dark:before:pointer-events-none dark:before:absolute dark:before:inset-0 dark:before:bg-black/10">

          {{ docsSidebar(page.path,'Getting Started',[
          { href: "/docs/overview", label: "Overview" },
          { href: "/docs/installation", label: "Installation" }
          ]) }}

          {{ docsSidebar(page.path,'Essentials',[
          { href: "/docs/partials", label: "Partials" }
          ]) }}

          {{ docsSidebar(page.path,'Template Languages',[
          { href: "/docs/template-languages/markdown", label: "Markdown" },
          { href: "/docs/template-languages/nunjucks", label: "Nunjucks" },
          { href: "/docs/template-languages/liquid", label: "Liquid" }
          ]) }}

          {{ docsSidebar(page.path,'JS Frameworks',[
          { href: "/docs/template-languages/vuejs", label: "Vue.js" },
          { href: "/docs/template-languages/alpinejs", label: "Alpine.js" }
          ]) }}

          {{ docsSidebar(page.path,'CSS Frameworks',[
          { href: "/docs/tailwindcss", label: "Tailwind CSS" },
          { href: "/docs/bootstrap", label: "Bootstrap" },
          { href: "/docs/foundation", label: "Foundation" }
          ]) }}
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>

<!-- Static sidebar for desktop -->
<div class="hidden bg-stone-950/50 lg:fixed lg:pt-24 lg:inset-y-0 lg:z-10 lg:flex lg:w-72 lg:flex-col">
  <!-- Sidebar component, swap this element with another sidebar if you like -->
  <div class="flex grow flex-col gap-y-5 overflow-y-auto pt-12 px-6 dark:border-white/10 dark:bg-black/10">
    {{ docsSidebar(page.path,'Getting Started',[
    { href: "/docs/overview", label: "Overview" },
    { href: "/docs/installation", label: "Installation" }
    ]) }}

    {{ docsSidebar(page.path,'Essentials',[
    { href: "/docs/partials", label: "Partials" }
    ]) }}

    {{ docsSidebar(page.path,'Template Languages',[
    { href: "/docs/template-languages/markdown", label: "Markdown" },
    { href: "/docs/template-languages/nunjucks", label: "Nunjucks" },
    { href: "/docs/template-languages/liquid", label: "Liquid" }
    ]) }}

    {{ docsSidebar(page.path,'JS Frameworks',[
    { href: "/docs/template-languages/vuejs", label: "Vue.js" },
    { href: "/docs/template-languages/alpinejs", label: "Alpine.js" }
    ]) }}

    {{ docsSidebar(page.path,'CSS Frameworks',[
    { href: "/docs/tailwindcss", label: "Tailwind CSS" },
    { href: "/docs/bootstrap", label: "Bootstrap" },
    { href: "/docs/foundation", label: "Foundation" }
    ]) }}
  </div>
</div>

<div
  class="sticky top-[58px] z-40 flex items-center gap-x-6 bg-stone-900 px-4 py-4 shadow sm:px-6 lg:hidden dark:shadow-none dark:after:pointer-events-none dark:after:absolute dark:after:inset-0 dark:after:border-b dark:after:border-white/10 dark:after:bg-black/10">
  <button type="button" command="show-modal" commandfor="sidebar"
    class="-m-2.5 p-2.5 text-white hover:text-stone-400 lg:hidden">
    <span class="sr-only">Open sidebar</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true"
      class="size-6">
      <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="flex-1">
    <h6 class="text-xs text-stone-400 leading-4">{{ page.subtitle }}</h6>
    <h3 class="text-xl text-white leading-5">{{ page.title }}</h3>
  </div>
</div>

<main class="py-10 lg:pl-72">
  <div class="grid grid-cols-12 px-4 sm:px-6 lg:px-8">
    <div class="col-span-8">
    <header>
      <div class="max-w-2xl min-w-0 flex-auto px-4 lg:max-w-none pt-12 mb-4 lg:pr-0 lg:pl-8 xl:px-16">
        <h6 class="text-base text-stone-200/50 font-medium">{{ page.subtitle }}</h6>
        <h1 class="text-4xl">{{ page.title }}</h1>
      </div>
    </header>
    <article class="docs max-w-2xl min-w-0 flex-auto px-4 lg:max-w-none lg:pr-0 lg:pl-8 xl:px-16 pb-[600px]">
      <p class="text-xl tracking-wide mb-12">{{ page.description }}</p>
      {{ content | safe }}
    </article>
    </div>
    {% set links = content | anchorsFromContent %}
    {% if links.length > 0 %}
    {{ docsAnchors(page,'On this page', links) }}
    {% endif %}
  </div>
</main>

<script>
// ScrollSpy for docs anchors using scroll position (stable order)
(() => {
  const nav = document.querySelector('[data-docs-anchor]');
  if (!nav) return;
  const links = Array.from(nav.querySelectorAll('a[href^="#"]'));
  const targets = links
    .map((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      const el = document.getElementById(id);
      return el ? { link, el } : null;
    })
    .filter(Boolean);

  if (!targets.length) return;

  const inactive = ['text-stone-500', 'hover:text-white', 'dark:text-stone-400', 'dark:hover:text-stone-300'];
  const active = ['font-semibold', 'text-amber-500', 'border-l-4', 'border-amber-500', '-ml-1'];
  const offset = 500; // px padding for header/breathing room

  // Sort targets by document position to keep ordering predictable
  const sorted = targets
    .map((t) => ({ ...t, top: t.el.getBoundingClientRect().top + window.scrollY }))
    .sort((a, b) => a.top - b.top);

  const setActive = (link) => {
    links.forEach((l) => {
      l.classList.remove(...active);
      l.classList.add(...inactive);
    });
    link.classList.add(...active);
    link.classList.remove(...inactive);
  };

  const update = () => {
    const pos = window.scrollY + offset;
    // Find first section below current pos; activate the one just before it
    let idx = sorted.findIndex((t) => t.top > pos);
    if (idx === -1) idx = sorted.length; // past last section
    const activeTarget = sorted[Math.max(0, idx - 1)];
    if (activeTarget) setActive(activeTarget.link);
  };

  const applyHashTarget = () => {
    const hash = decodeURIComponent(window.location.hash || '').replace('#', '');
    if (!hash) return false;
    const target = sorted.find((t) => t.el.id === hash);
    if (target) {
      setActive(target.link);
      return true;
    }
    return false;
  };

  // Immediate feedback on click (before scroll settles)
  links.forEach((link) => {
    link.addEventListener('click', () => setActive(link));
  });

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', () => {
    // Recompute tops on resize to keep accuracy
    sorted.forEach((t) => {
      t.top = t.el.getBoundingClientRect().top + window.scrollY;
    });
    update();
  });

  window.addEventListener('hashchange', () => {
    if (!applyHashTarget()) update();
  });

  // Initial state
  if (!applyHashTarget()) update();
})();
</script>
{% endblock %}