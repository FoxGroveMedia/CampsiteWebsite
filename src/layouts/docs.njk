{% extends "base.njk" %}
{% from "partials/docs-sidebar.njk" import docsSidebar %}

{% block content %}
<el-dialog>
  <dialog id="sidebar" class="m-0 p-0 backdrop:bg-transparent lg:hidden">
    <el-dialog-backdrop
      class="fixed inset-0 bg-[#05030A]/90 transition-opacity duration-300 ease-linear data-[closed]:opacity-0"></el-dialog-backdrop>

    <div tabindex="0" class="fixed inset-0 flex focus:outline focus:outline-0">
      <el-dialog-panel
        class="group/dialog-panel relative mr-16 flex w-full max-w-xs flex-1 transform transition duration-300 ease-in-out data-[closed]:-translate-x-full">
        <div
          class="absolute left-full top-0 flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-[closed]/dialog-panel:opacity-0">
          <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
            <span class="sr-only">Close sidebar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 text-white">
              <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-[#0E0B16]/95 py-8 px-6 ring-1 ring-white/10">
          {{ docsSidebar(page.path,'Getting Started',[
          { href: "/docs", label: "Overview" },
          { href: "/docs/getting-started/installation", label: "Installation" },
          { href: "/docs/getting-started/deploying", label: "Deploying" }
          ]) }}

          {{ docsSidebar(page.path,'CLI Reference',[
          { href: "/docs/cli", label: "Overview" },
          { href: "/docs/cli/commands", label: "All Commands" },
          { href: "/docs/cli/make-commands", label: "Make Commands" }
          ]) }}

          {{ docsSidebar(page.path,'Essentials',[
          { href: "/docs/essentials/collections", label: "Collections" },
          { href: "/docs/essentials/components", label: "Components" },
          { href: "/docs/essentials/configuration", label: "Configuration" },
          { href: "/docs/essentials/extending", label: "Extending" },
          { href: "/docs/essentials/file-exclusion", label: "File Exclusion" },
          { href: "/docs/essentials/partials", label: "Partials" },
          { href: "/docs/essentials/photo-compression", label: "Photo Compression" }
          ]) }}

          {{ docsSidebar(page.path,'Template Languages',[
          { href: "/docs/template-languages", label: "Overview" },
          { href: "/docs/template-languages/liquid", label: "Liquid" },
          { href: "/docs/template-languages/markdown", label: "Markdown" },
          { href: "/docs/template-languages/mustache", label: "Mustache" },
          { href: "/docs/template-languages/nunjucks", label: "Nunjucks" }
          ]) }}

          {{ docsSidebar(page.path,'JS Frameworks',[
          { href: "/docs/js-frameworks", label: "Overview" },
          { href: "/docs/js-frameworks/alpinejs", label: "Alpine.js" },
          { href: "/docs/js-frameworks/vuejs", label: "Vue.js" }
          ]) }}

          {{ docsSidebar(page.path,'CSS Frameworks',[
          { href: "/docs/css-frameworks", label: "Overview" },
          { href: "/docs/css-frameworks/bootstrap", label: "Bootstrap" },
          { href: "/docs/css-frameworks/bulma", label: "Bulma" },
          { href: "/docs/css-frameworks/foundation", label: "Foundation" },
          { href: "/docs/css-frameworks/tailwindcss", label: "Tailwind CSS" }
          ]) }}
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>

<!-- Static sidebar for desktop -->
<div class="hidden bg-[#05030A]/60 lg:fixed lg:pt-16 lg:inset-y-0 lg:z-10 lg:flex lg:w-72 lg:flex-col border-r border-white/5">
  <div class="flex grow flex-col gap-y-5 overflow-y-auto pt-8 px-6">
    {{ docsSidebar(page.path,'Getting Started',[
    { href: "/docs", label: "Overview" },
    { href: "/docs/getting-started/installation", label: "Installation" },
    { href: "/docs/getting-started/deploying", label: "Deploying" }
    ]) }}

    {{ docsSidebar(page.path,'CLI Reference',[
    { href: "/docs/cli", label: "Overview" },
    { href: "/docs/cli/commands", label: "All Commands" },
    { href: "/docs/cli/make-commands", label: "Make Commands" }
    ]) }}

    {{ docsSidebar(page.path,'Essentials',[
    { href: "/docs/essentials/collections", label: "Collections" },
    { href: "/docs/essentials/components", label: "Components" },
    { href: "/docs/essentials/configuration", label: "Configuration" },
    { href: "/docs/essentials/extending", label: "Extending" },
    { href: "/docs/essentials/file-exclusion", label: "File Exclusion" },
    { href: "/docs/essentials/partials", label: "Partials" },
    { href: "/docs/essentials/photo-compression", label: "Photo Compression" }
    ]) }}

    {{ docsSidebar(page.path,'Template Languages',[
    { href: "/docs/template-languages", label: "Overview" },
    { href: "/docs/template-languages/liquid", label: "Liquid" },
    { href: "/docs/template-languages/markdown", label: "Markdown" },
    { href: "/docs/template-languages/mustache", label: "Mustache" },
    { href: "/docs/template-languages/nunjucks", label: "Nunjucks" }
    ]) }}

    {{ docsSidebar(page.path,'JS Frameworks',[
    { href: "/docs/js-frameworks", label: "Overview" },
    { href: "/docs/js-frameworks/alpinejs", label: "Alpine.js" },
    { href: "/docs/js-frameworks/vuejs", label: "Vue.js" }
    ]) }}

    {{ docsSidebar(page.path,'CSS Frameworks',[
    { href: "/docs/css-frameworks", label: "Overview" },
    { href: "/docs/css-frameworks/bootstrap", label: "Bootstrap" },
    { href: "/docs/css-frameworks/bulma", label: "Bulma" },
    { href: "/docs/css-frameworks/foundation", label: "Foundation" },
    { href: "/docs/css-frameworks/tailwindcss", label: "Tailwind CSS" }
    ]) }}
  </div>
</div>

<!-- Mobile top bar -->
<div class="sticky top-16 z-40 flex items-center gap-x-6 bg-[#0E0B16] border-b border-white/5 px-4 py-3 shadow sm:px-6 lg:hidden">
  <button type="button" command="show-modal" commandfor="sidebar"
    class="-m-2.5 p-2.5 text-zinc-400 hover:text-white lg:hidden">
    <span class="sr-only">Open sidebar</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6">
      <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="flex-1 min-w-0">
    <p class="text-xs text-zinc-500 leading-4 truncate">{{ page.subtitle }}</p>
    <p class="text-sm text-white leading-5 font-semibold truncate">{{ page.title }}</p>
  </div>
</div>

<div class="py-10 lg:pl-72">
  <div class="px-4 sm:px-6 lg:px-8">
    <header class="max-w-3xl pt-8 mb-6 px-4 lg:px-8">
      <p class="text-sm text-zinc-500 font-medium tracking-wide mb-1">{{ page.subtitle }}</p>
      <h1 class="text-4xl font-bold text-white">{{ page.title }}</h1>
    </header>
    <article class="docs max-w-3xl px-4 lg:px-8">
      <p class="text-lg text-zinc-400 leading-relaxed mb-10">{{ page.description }}</p>
      {{ content | safe }}
    </article>
  </div>
</div>

{% endblock %}
